# 複製成 .env 後填值。settings.py 會以 python-dotenv 自動載入專案根目錄的 .env。
# .env 已被 .gitignore 排除，請勿提交真正的值。

# ---- 開發 ----
# 1 = 開發模式：預設使用 MockProvider（假 OAuth，輸入學號即可登入）、開放 /admin/。
DJANGO_DEBUG=1

# ---- 資料庫 ----
# Docker（compose.yaml）會用下面三個值啟動 Postgres，並自動組出 web 的 DATABASE_URL。
POSTGRES_DB=proofforge
POSTGRES_USER=proofforge
# 正式環境務必換成長隨機字串
POSTGRES_PASSWORD=change-me
# 不用 Docker 時：留空 = 使用專案根目錄的 SQLite（db.sqlite3）。
# 正式環境（DJANGO_DEBUG 不為 1）必填；用 compose 時由 compose.yaml 自動提供，除非要連外部資料庫。
# 例：postgres://proofforge:密碼@db:5432/proofforge
DATABASE_URL=

# ---- 正式環境（DJANGO_DEBUG 不為 1 時以下標 * 者必填，否則拒絕啟動）----
# * 長隨機字串，例如：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# * 逗號分隔，例如 proofforge.example.edu.tw
DJANGO_ALLOWED_HOSTS=
# * 正式環境請設 accounts.ncu_provider.NCUPortalProvider（MockProvider 在非 DEBUG 下會被拒絕）
OAUTH_PROVIDER_CLASS=
# * 必須與在 NCU Portal 註冊的 redirect URI 完全一致，且為 https
OAUTH_REDIRECT_URI=

# NCU Portal OAuth 憑證（使用 NCUPortalProvider 時必填）
NCU_OAUTH_CLIENT_ID=
NCU_OAUTH_CLIENT_SECRET=
# 選填；不設定則使用 https://portal.ncu.edu.tw
NCU_PORTAL_BASE_URL=

# 選填；1 = 開放 /admin/。預設：開發模式開、正式環境關。
DJANGO_ENABLE_ADMIN=
